# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Elasticsearch (compose default)
ES_URL=http://localhost:9200

# LLM and embeddings (server side only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Dash0 / OpenTelemetry (server side only). Leave the endpoint empty to run without exporting.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Authorization=Bearer <server token>,Dash0-Dataset=confox
OTEL_EXPORTER_OTLP_HEADERS=

# Demo only: enables POST /api/debug/break, which triggers a real Elasticsearch error
ENABLE_DEBUG_ENDPOINTS=false

# Browser RUM: this token must be an ingest-only Dash0 token, it ships to every visitor.
VITE_DASH0_ENDPOINT=
VITE_DASH0_TOKEN=
VITE_DASH0_DATASET=confox
