# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Elasticsearch (compose default)
ES_URL=http://localhost:9200

# LLM and embeddings (server side only)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Dash0 / OpenTelemetry (server side only)
OTEL_SERVICE_NAME=confox-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=

# Browser RUM: this token must be an ingest-only Dash0 token, it ships to every visitor.
VITE_DASH0_ENDPOINT=
VITE_DASH0_TOKEN=
